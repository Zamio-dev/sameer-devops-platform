# ============================================================
# Sameer DevOps Platform — Environment Variables
# ============================================================
# Copy this file to .env and fill in real values
# NEVER commit .env to version control
# ============================================================

# Application
APP_ENV=development          # development | staging | production
APP_PORT=8080
APP_NAME=sameer-devops-platform

# Database (PostgreSQL)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=platform_db
DB_USER=platform_user
DB_PASSWORD=CHANGE_ME_IN_PRODUCTION
DB_SSL_MODE=disable           # disable for local, require for production
DB_MAX_CONNECTIONS=25

# Cache (Redis)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=               # Empty for local dev
REDIS_DB=0

# Authentication
JWT_SECRET=CHANGE_ME_MINIMUM_32_CHARACTERS_LONG
JWT_EXPIRY_HOURS=24
REFRESH_TOKEN_EXPIRY_DAYS=7

# OAuth (get these from GitHub/Google developer consoles)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Monitoring
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
PROMETHEUS_RETENTION_DAYS=30

# Logging
LOG_LEVEL=debug               # debug | info | warn | error

# Email (optional, for notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
